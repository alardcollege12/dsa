#include <iostream>
using namespace std;
struct Node {
    int data;
    Node* prev;
    Node* next;
};
Node* createNode(int data) {
    Node* newNode = new Node();
    newNode->data = data;
    newNode->prev = nullptr;
    newNode->next = nullptr;
    return newNode;
}
void insertAtEnd(Node*& head, int data) {
    Node* newNode = createNode(data);
    if (head == nullptr) {
        head = newNode;
        return;
    }
    Node* temp = head;
    while (temp->next != nullptr)
        temp = temp->next;
    temp->next = newNode;
    newNode->prev = temp;
}
void insertAtBeginning(Node*& head, int data) {
    Node* newNode = createNode(data);
    if (head == nullptr) {
        head = newNode;
        return;
    }
    newNode->next = head;
    head->prev = newNode;
    head = newNode;
}
void deleteNode(Node*& head, int key) {
    if (head == nullptr) {
        cout << "List is empty!\n";
        return;
    }
    Node* temp = head;
    if (temp->data == key) {
        head = temp->next;
        if (head != nullptr)
            head->prev = nullptr;
        delete temp;
        cout << "Node deleted successfully.\n";
        return;
    }
    while (temp != nullptr && temp->data != key)
        temp = temp->next;
    if (temp == nullptr) {
        cout << "Node not found!\n";
        return;
    }
    if (temp->next != nullptr)
        temp->next->prev = temp->prev;
    if (temp->prev != nullptr)
        temp->prev->next = temp->next;
    delete temp;
    cout << "Node deleted successfully.\n";
}
void traverseForward(Node* head) {
    if (head == nullptr) {
        cout << "List is empty!\n";
        return;
    }
    cout << "Doubly Linked List (Forward): ";
    Node* temp = head;
    while (temp != nullptr) {
        cout << temp->data << " <-> ";
        temp = temp->next;
    }
    cout << "NULL\n";
}
void traverseBackward(Node* head) {
    if (head == nullptr) {
        cout << "List is empty!\n";
        return;
    }
    Node* temp = head;
    while (temp->next != nullptr)
        temp = temp->next;
    cout << "Doubly Linked List (Backward): ";
    while (temp != nullptr) {
        cout << temp->data << " <-> ";
        temp = temp->prev;
    }
    cout << "NULL\n";
}
int main() {
    Node* head = nullptr;
    int choice, data, key;
    while (true) {
        cout << "\nDoubly Linked List Operations\n";
        cout << "1. Create Node (Insert at End)\n";
        cout << "2. Insert at Beginning\n";
        cout << "3. Delete a Node\n";
        cout << "4. Traverse Forward\n";
        cout << "5. Traverse Backward\n";
        cout << "6. Exit\n";
        cout << "Enter your choice: ";
        cin >> choice;
        switch (choice) {
            case 1:
                cout << "Enter data to insert at end: ";
                cin >> data;
                insertAtEnd(head, data);
                break;
            case 2:
                cout << "Enter data to insert at beginning: ";
                cin >> data;
                insertAtBeginning(head, data);
                break;
            case 3:
                cout << "Enter value to delete: ";
                cin >> key;
                deleteNode(head, key);
                break;
            case 4:
                traverseForward(head);
                break;
            case 5:
                traverseBackward(head);
                break;
            case 6:
                cout << "Exiting program...\n";
                return 0;
            default:
                cout << "Invalid choice! Please try again.\n";
        }
    }
}
